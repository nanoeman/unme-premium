generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// NEXTAUTH MODELS
// ═══════════════════════════════════════════════════════════════

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

// ═══════════════════════════════════════════════════════════════
// USERS & AUTH
// ═══════════════════════════════════════════════════════════════

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  password       String?   // Para credentials provider
  role           UserRole  @default(CUSTOMER)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  profile        Profile?
  bookings       Booking[]
  payments       Payment[]
  invoices       Invoice[]
  messages       Message[]
  consents       Consent[]
  reviews        Review[]
  orders         Order[]
  blogPosts      BlogPost[]
  comments       Comment[]

  @@map("users")
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
  TEACHER
}

model Profile {
  id               String   @id @default(cuid())
  userId           String   @unique
  phone            String?
  birthDate        DateTime?
  nationality      String?
  diet             DietType @default(OMNIVORE)
  allergies        String?
  preferences      String?
  emergencyContact String?
  observations     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

enum DietType {
  OMNIVORE
  VEGETARIAN
  VEGAN
  GLUTEN_FREE
  HALAL
  KOSHER
}

// ═══════════════════════════════════════════════════════════════
// RETREATS
// ═══════════════════════════════════════════════════════════════

model Retreat {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  subtitle    String?
  description String
  shortDesc   String?
  price       Float
  deposit     Float?
  duration    Int
  maxGuests   Int
  minGuests   Int           @default(1)
  location    String
  coverImage  String?
  videoUrl    String?
  status      RetreatStatus @default(DRAFT)
  featured    Boolean       @default(false)
  seoTitle    String?
  seoDesc     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  schedules   RetreatSchedule[]
  rooms       Room[]
  activities  Activity[]
  teachers    RetreatTeacher[]
  gallery     GalleryImage[]
  reviews     Review[]
  faqs        FAQ[]
  bookings    Booking[]

  @@map("retreats")
}

enum RetreatStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model RetreatSchedule {
  id             String         @id @default(cuid())
  retreatId      String
  startDate      DateTime
  endDate        DateTime
  price          Float?
  spotsTotal     Int
  spotsLeft      Int
  status         ScheduleStatus @default(OPEN)
  createdAt      DateTime       @default(now())

  retreat        Retreat        @relation(fields: [retreatId], references: [id], onDelete: Cascade)
  bookings       Booking[]
  calendarEvents CalendarEvent[]

  @@map("retreat_schedules")
}

enum ScheduleStatus {
  OPEN
  CLOSED
  WAITLIST
  CANCELLED
}

// ═══════════════════════════════════════════════════════════════
// ROOMS
// ═══════════════════════════════════════════════════════════════

model Room {
  id          String   @id @default(cuid())
  retreatId   String
  name        String
  type        RoomType
  description String?
  pricePerNight Float
  capacity    Int      @default(1)
  amenities   String
  images      String
  createdAt   DateTime @default(now())

  retreat     Retreat  @relation(fields: [retreatId], references: [id], onDelete: Cascade)
  bookings    BookingRoom[]

  @@map("rooms")
}

enum RoomType {
  SINGLE
  DOUBLE
  SUITE
  SHARED
  GLAMPING
}

// ═══════════════════════════════════════════════════════════════
// BOOKINGS
// ═══════════════════════════════════════════════════════════════

model Booking {
  id              String        @id @default(cuid())
  userId          String?
  scheduleId      String?
  retreatId       String?
  status          BookingStatus @default(PENDING)
  totalAmount     Float         @default(0)
  depositAmount   Float?
  paidAmount      Float         @default(0)
  paymentStatus   PaymentStatus @default(PENDING)
  guests          Int           @default(1)
  specialRequests String?
  couponCode      String?
  discountAmount  Float?
  checkIn         DateTime?
  checkOut        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  // Campos adicionales para formulario de reserva
  experience      String?
  date            String?
  name            String?
  email           String?
  phone           String?

  user            User?          @relation(fields: [userId], references: [id])
  schedule        RetreatSchedule? @relation(fields: [scheduleId], references: [id])
  retreat         Retreat?        @relation(fields: [retreatId], references: [id])
  rooms           BookingRoom[]
  payments        Payment[]
  invoice         Invoice?
  activities      BookingActivity[]

  @@map("bookings")
}

model BookingRoom {
  id        String @id @default(cuid())
  bookingId String
  roomId    String
  nights    Int
  price     Float

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room      Room    @relation(fields: [roomId], references: [id])

  @@map("booking_rooms")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
  FAILED
}

// ═══════════════════════════════════════════════════════════════
// PAYMENTS
// ═══════════════════════════════════════════════════════════════

model Payment {
  id          String          @id @default(cuid())
  bookingId   String?
  orderId     String?
  userId      String
  amount      Float
  currency    String          @default("EUR")
  provider    PaymentProvider
  providerRef String?
  status      PaymentStatus   @default(PENDING)
  type        PaymentType     @default(FULL)
  metadata    String?
  createdAt   DateTime        @default(now())

  user        User            @relation(fields: [userId], references: [id])
  booking     Booking?        @relation(fields: [bookingId], references: [id])
  order       Order?          @relation(fields: [orderId], references: [id])

  @@map("payments")
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  BANK_TRANSFER
  CASH
}

enum PaymentType {
  DEPOSIT
  FULL
  BALANCE
  REFUND
  GIFT_CARD
}

// ═══════════════════════════════════════════════════════════════
// INVOICES
// ═══════════════════════════════════════════════════════════════

model Invoice {
  id        String        @id @default(cuid())
  bookingId String        @unique
  userId    String
  number    String        @unique
  amount    Float
  taxAmount Float
  taxRate   Float         @default(21)
  pdfUrl    String?
  status    InvoiceStatus @default(DRAFT)
  sentAt    DateTime?
  createdAt DateTime      @default(now())

  booking   Booking       @relation(fields: [bookingId], references: [id])
  user      User          @relation(fields: [userId], references: [id])

  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

// ═══════════════════════════════════════════════════════════════
// CALENDAR
// ═══════════════════════════════════════════════════════════════

model CalendarEvent {
  id         String          @id @default(cuid())
  title      String
  type       CalendarEventType
  startDate  DateTime
  endDate    DateTime
  allDay     Boolean         @default(true)
  scheduleId String?
  roomId     String?
  notes      String?
  color      String?
  createdAt  DateTime        @default(now())

  schedule RetreatSchedule? @relation(fields: [scheduleId], references: [id])

  @@map("calendar_events")
}

enum CalendarEventType {
  OCCUPIED
  FREE
  BOOKED
  MAINTENANCE
  PRIVATE
  FULL
}

// ═══════════════════════════════════════════════════════════════
// MARKETPLACE
// ═══════════════════════════════════════════════════════════════

model Product {
  id           String      @id @default(cuid())
  slug         String      @unique
  name         String
  description  String
  price        Float
  comparePrice Float?
  sku          String      @unique
  stock        Int         @default(0)
  images       String
  categoryId   String
  tags         String
  weight       Float?
  dimensions   String?
  seoTitle     String?
  seoDesc      String?
  status       ProductStatus @default(DRAFT)
  featured     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  category     ProductCategory @relation(fields: [categoryId], references: [id])
  variants     ProductVariant[]
  orderItems   OrderItem[]

  @@map("products")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

model ProductCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  parentId    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  parent      ProductCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    ProductCategory[] @relation("CategoryHierarchy")
  products    Product[]

  @@map("product_categories")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  name      String
  sku       String  @unique
  price     Float
  stock     Int     @default(0)
  createdAt DateTime @default(now())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  status          OrderStatus @default(PENDING)
  totalAmount     Float
  shippingAddress String?
  trackingNumber  String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User        @relation(fields: [userId], references: [id])
  items           OrderItem[]
  payments        Payment[]

  @@map("orders")
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

// ═══════════════════════════════════════════════════════════════
// BLOG
// ═══════════════════════════════════════════════════════════════

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String?
  content     String
  coverImage  String?
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  authorId    String
  categoryId  String?
  tags        String
  seoTitle    String?
  seoDesc     String?
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      User     @relation(fields: [authorId], references: [id])
  category    BlogCategory? @relation(fields: [categoryId], references: [id])
  comments    Comment[]

  @@map("blog_posts")
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model BlogCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())

  posts       BlogPost[]

  @@map("blog_categories")
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String?
  name      String?
  email     String?
  content   String
  status    CommentStatus @default(PENDING)
  parentId  String?
  createdAt DateTime @default(now())

  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")

  @@map("comments")
}

enum CommentStatus {
  PENDING
  APPROVED
  SPAM
}

// ═══════════════════════════════════════════════════════════════
// SUPPORTING ENTITIES
// ═══════════════════════════════════════════════════════════════

model Teacher {
  id          String   @id @default(cuid())
  name        String
  bio         String
  photo       String?
  specialties String
  languages   String
  socialLinks String?
  createdAt   DateTime @default(now())

  retreats    RetreatTeacher[]

  @@map("teachers")
}

model RetreatTeacher {
  retreatId String
  teacherId String
  role      String?

  retreat   Retreat  @relation(fields: [retreatId], references: [id], onDelete: Cascade)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([retreatId, teacherId])
  @@map("retreat_teachers")
}

model Activity {
  id          String   @id @default(cuid())
  retreatId   String
  name        String
  description String?
  duration    Int
  schedule    String?
  day         Int?
  type        ActivityType
  createdAt   DateTime @default(now())

  retreat     Retreat  @relation(fields: [retreatId], references: [id], onDelete: Cascade)
  bookings    BookingActivity[]

  @@map("activities")
}

enum ActivityType {
  MEDITATION
  YOGA
  WORKSHOP
  NATURE_WALK
  SOUND_BATH
  BREATHWORK
  COOKING
  MASSAGE
  FREE_TIME
}

model BookingActivity {
  id         String  @id @default(cuid())
  bookingId  String
  activityId String
  attended   Boolean @default(false)
  notes      String?

  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("booking_activities")
}

model GalleryImage {
  id        String @id @default(cuid())
  retreatId String
  url       String
  caption   String?
  sortOrder Int    @default(0)
  createdAt DateTime @default(now())

  retreat   Retreat @relation(fields: [retreatId], references: [id], onDelete: Cascade)

  @@map("gallery_images")
}

model Review {
  id        String @id @default(cuid())
  retreatId String
  userId    String
  rating    Int
  title     String?
  content   String
  images    String
  verified  Boolean @default(false)
  createdAt DateTime @default(now())

  retreat   Retreat @relation(fields: [retreatId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id])

  @@unique([retreatId, userId])
  @@map("reviews")
}

model FAQ {
  id        String @id @default(cuid())
  retreatId String
  question  String
  answer    String
  sortOrder Int    @default(0)
  createdAt DateTime @default(now())

  retreat   Retreat @relation(fields: [retreatId], references: [id], onDelete: Cascade)

  @@map("faqs")
}

model Message {
  id        String      @id @default(cuid())
  userId    String
  subject   String
  content   String
  type      MessageType @default(GENERAL)
  readAt    DateTime?
  createdAt DateTime    @default(now())

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("messages")
}

enum MessageType {
  GENERAL
  BOOKING_CONFIRMATION
  PAYMENT_RECEIPT
  REMINDER
  REVIEW_REQUEST
  NEWSLETTER
}

model Consent {
  id        String     @id @default(cuid())
  userId    String
  type      ConsentType
  granted   Boolean    @default(false)
  grantedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime   @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("consents")
}

enum ConsentType {
  MARKETING
  ANALYTICS
  TERMS
  PRIVACY
  COOKIES
}

model Coupon {
  id           String     @id @default(cuid())
  code         String     @unique
  type         CouponType
  value        Float
  minAmount    Float?
  maxUses      Int?
  usedCount    Int        @default(0)
  validFrom    DateTime
  validUntil   DateTime?
  applicableTo String
  createdAt    DateTime   @default(now())

  @@map("coupons")
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

model GiftCard {
  id             String         @id @default(cuid())
  code           String         @unique
  amount         Float
  balance        Float
  purchaserId    String
  recipientEmail String?
  message        String?
  status         GiftCardStatus @default(ACTIVE)
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())

  @@map("gift_cards")
}

enum GiftCardStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

// ═══════════════════════════════════════════════════════════════
// CRM INTEGRATION (Dossier Arquitectura Premium)
// ═══════════════════════════════════════════════════════════════

model CrmContact {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  phone        String?
  customerTier String   @default("STANDARD")
  source       String?
  interests    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings CrmBooking[]
  leads    CrmLead[]

  @@map("crm_contacts")
}

model CrmBooking {
  id            String   @id @default(cuid())
  contactId     String
  serviceType   String
  totalAmount   Float
  status        String   @default("PENDING")
  paymentStatus String   @default("PENDING")
  eventDate     DateTime?
  guests        Int      @default(1)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contact CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@map("crm_bookings")
}

model CrmLead {
  id            String   @id @default(cuid())
  contactId     String?
  email         String
  sourcePage    String
  interestsTags String?
  status        String   @default("NEW")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contact CrmContact? @relation(fields: [contactId], references: [id])

  @@map("crm_leads")
}
